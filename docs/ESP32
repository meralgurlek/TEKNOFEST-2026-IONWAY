#include <WiFi.h>
#include <esp_now.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

/* =========================================================
   PIN DEFINITIONS
   ========================================================= */

#define HV_RELAY_PIN      26
#define STATUS_LED        2

#define VOLTAGE_SENSOR    34
#define CURRENT_SENSOR    35
#define TEMP_SENSOR       32

/* =========================================================
   SYSTEM VARIABLES
   ========================================================= */

float voltage = 0;
float current = 0;
float power   = 0;
float tempC   = 0;

bool propulsionActive = false;

/* =========================================================
   ESP-NOW DATA STRUCTURE
   ========================================================= */

typedef struct __attribute__((packed)) {

  char systemName[20];

  float voltage;
  float current;
  float power;
  float temperature;

  bool propulsionStatus;

  int64_t timestamp;

} system_packet;

system_packet packet;

/* =========================================================
   PEER MAC ADDRESS
   ========================================================= */

uint8_t gatewayAddress[] = {0x24,0x6F,0x28,0x11,0x22,0x33};

/* =========================================================
   SEND CALLBACK
   ========================================================= */

void OnDataSent(const wifi_tx_info_t *info, esp_now_send_status_t status) {

  Serial.print("Packet Send Status: ");

  if(status == ESP_NOW_SEND_SUCCESS) {
    Serial.println("SUCCESS");
  }
  else {
    Serial.println("FAILED");
  }
}

/* =========================================================
   OLED DISPLAY FUNCTION
   ========================================================= */

void updateDisplay() {

  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(WHITE);

  display.setCursor(0,0);
  display.println("IONWAY SYSTEM");

  display.setCursor(0,15);
  display.print("V: ");
  display.print(voltage,1);
  display.println(" V");

  display.setCursor(0,25);
  display.print("I: ");
  display.print(current,2);
  display.println(" A");

  display.setCursor(0,35);
  display.print("P: ");
  display.print(power,1);
  display.println(" W");

  display.setCursor(0,45);
  display.print("T: ");
  display.print(tempC,1);
  display.println(" C");

  if(propulsionActive) {

    display.fillRect(80,0,48,12,WHITE);

    display.setTextColor(BLACK);
    display.setCursor(85,2);
    display.print("ACTIVE");

  } else {

    display.drawRect(80,0,48,12,WHITE);

    display.setTextColor(WHITE);
    display.setCursor(85,2);
    display.print("IDLE");
  }

  display.display();
}

/* =========================================================
   SENSOR READ FUNCTION
   ========================================================= */

void readSensors() {

  voltage = analogRead(VOLTAGE_SENSOR) * 0.025;
  current = analogRead(CURRENT_SENSOR) * 0.010;
  tempC   = analogRead(TEMP_SENSOR) * 0.020;

  power = voltage * current;
}

/* =========================================================
   PROPULSION CONTROL
   ========================================================= */

void controlPropulsion() {

  if(voltage > 20.0) {

    digitalWrite(HV_RELAY_PIN, HIGH);

    propulsionActive = true;

  } else {

    digitalWrite(HV_RELAY_PIN, LOW);

    propulsionActive = false;
  }
}

/* =========================================================
   SEND DATA FUNCTION
   ========================================================= */

void sendTelemetry() {

  strcpy(packet.systemName, "IONWAY");

  packet.voltage = voltage;
  packet.current = current;
  packet.power = power;
  packet.temperature = tempC;

  packet.propulsionStatus = propulsionActive;

  packet.timestamp = esp_timer_get_time();

  esp_err_t result = esp_now_send(
    gatewayAddress,
    (uint8_t *) &packet,
    sizeof(packet)
  );

  if(result == ESP_OK) {

    Serial.println("Data Sent");

  } else {

    Serial.println("Send Error");
  }
}

/* =========================================================
   SETUP
   ========================================================= */

void setup() {

  Serial.begin(115200);

  pinMode(HV_RELAY_PIN, OUTPUT);
  pinMode(STATUS_LED, OUTPUT);

  digitalWrite(HV_RELAY_PIN, LOW);

  /* OLED INIT */

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {

    Serial.println("OLED ERROR");

    while(true);
  }

  display.clearDisplay();
  display.display();

  /* WIFI INIT */

  WiFi.mode(WIFI_STA);

  /* ESP-NOW INIT */

  if(esp_now_init() != ESP_OK) {

    Serial.println("ESP-NOW INIT FAILED");

    ESP.restart();
  }

  esp_now_register_send_cb(OnDataSent);

  /* PEER CONFIG */

  esp_now_peer_info_t peerInfo = {};

  memcpy(peerInfo.peer_addr, gatewayAddress, 6);

  peerInfo.channel = 0;
  peerInfo.encrypt = false;

  if(esp_now_add_peer(&peerInfo) != ESP_OK) {

    Serial.println("PEER ADD FAILED");

    return;
  }

  Serial.println("IONWAY SYSTEM READY");
}

/* =========================================================
   LOOP
   ========================================================= */

void loop() {

  readSensors();

  controlPropulsion();

  updateDisplay();

  sendTelemetry();

  digitalWrite(STATUS_LED,!digitalRead(STATUS_LED));

  Serial.println("-------------------");

  Serial.print("Voltage: ");
  Serial.println(voltage);

  Serial.print("Current: ");
  Serial.println(current);

  Serial.print("Power: ");
  Serial.println(power);

  Serial.print("Temperature: ");
  Serial.println(tempC);

  delay(2000);
}
